{
    "name": "thiagomargatho/vermeuip",
    "description": "vermeuip.com.br - ferramentas de rede em portugues",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "maxmind-db/reader": "^1.11",
        "symfony/polyfill-intl-idn": "^1.43",
        "symfony/polyfill-mbstring": "^1.43",
        "symfony/polyfill-intl-normalizer": "^1.43"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Vermeuip\\": "public/_lib/"
        }
    },
    "config": {
        "vendor-dir": "public/vendor",
        "platform": {
            "php": "8.1.0"
        }
    }
}
